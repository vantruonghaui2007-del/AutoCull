{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "playwright.config.mts",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/worker/**/*",
    "src/project/**/*",
    "src/source/**/*",
    "src/media/**/*",
    "src/culling/**/*",
    "src/export/**/*",
    "scripts/**/*.mts",
    "tests/**/*"
  ]
}
